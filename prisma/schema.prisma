generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Broker {
  id           String    @id @default(uuid())
  name         String    @unique // "Interactive Brokers", "Tastytrade"
  status       String    // "connected", "disconnected"
  lastSyncTime DateTime  @default(now())
  holdings     Holding[]
}

model Holding {
  id                String   @id @default(uuid())
  brokerId          String
  broker            Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  
  symbol            String
  assetType         String   // "EQUITY", "OPTION"
  description       String?
  
  // Position Data
  brokerSpecificId  String   // e.g., conId for IBKR, symbol for Tasty
  quantity          Float
  averageCost       Float
  currentPrice      Float
  marketValue       Float
  
  // PnL
  dayPnL            Float
  dayPnLPercent     Float
  unrealizedPnL     Float
  unrealizedPnLPercent Float
  
  // Option Specifics (Nullable)
  strikePrice       Float?
  expiryDate        String?  // YYYYMMDD
  optionType        String?  // "CALL", "PUT"
  underlyingSymbol  String?
  
  currency          String?  @default("USD")
  
  updatedAt         DateTime @updatedAt

  @@unique([brokerId, brokerSpecificId])
}

model Watchlist {
  id        String          @id @default(uuid())
  name      String
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     WatchlistItem[]
}

model WatchlistItem {
  id          String    @id @default(uuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  symbol      String
  addedAt     DateTime  @default(now())

  @@unique([watchlistId, symbol])
}

model PriceAlert {
  id             String    @id @default(uuid())
  symbol         String
  targetPrice    Float
  condition      String    // "ABOVE" | "BELOW"
  status         String    @default("ACTIVE") // "ACTIVE" | "TRIGGERED" | "CANCELLED"
  isMuted        Boolean   @default(false)
  mutedAt        DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  triggeredAt    DateTime?
  triggeredPrice Float?
}

model ReportPromptTemplate {
  id           String   @id @default(uuid())
  name         String   // e.g. "Company Research Report", "Management Report", "Latest Earnings Report"
  slug         String   @unique
  description  String
  category     String   @default("RESEARCH")
  systemPrompt String
  userPrompt   String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StockNote {
  id        String   @id @default(uuid())
  symbol    String   @unique
  content   String
  tags      String?
  sentiment String?  // "BULLISH" | "BEARISH" | "NEUTRAL"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TradeIdea {
  id              String    @id @default(uuid())
  title           String
  symbol          String    // e.g. "NVDA", "AAPL", "MACRO"
  type            String    // "BULLISH" | "BEARISH" | "NEUTRAL"
  timeframe       String?   // "SHORT_TERM" | "SWING" | "LONG_TERM"
  entryPrice      Float?
  targetPrice     Float?
  stopLoss        Float?
  content         String    // Markdown formatted thesis, catalysts, and exit strategy
  tags            String?   // comma-separated tags
  status          String    @default("ACTIVE") // "ACTIVE" | "WATCHING" | "PLAYED_OUT" | "ARCHIVED"
  confidenceScore Int?      // 1 to 100
  source          String    @default("MANUAL") // "MANUAL" | "AI_AGENT"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AutonomousReport {
  id               String   @id @default(uuid())
  symbol           String   // e.g. "AAPL"
  reportType       String   // e.g. "company_research", "management", "earnings", or custom slug
  title            String   // e.g. "Company In-Depth Research Report: AAPL"
  convictionScore  Int?     // 1 to 100
  summary          String?  // Short summary or stringified executive bullet points
  contentJson      String   // Full raw structured JSON payload from the AI agent
  pdfPath          String?  // Local file path or relative path to generated PDF
  promptTemplateId String?  // Optional reference to ReportPromptTemplate
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([symbol])
  @@index([createdAt])
}

model PortfolioAuditReport {
  id                  String   @id @default(uuid())
  title               String   // e.g. "Portfolio Tactical Audit & Risk Assessment"
  healthScore         Int      // 0 to 100 (Overall Portfolio Resilience Score)
  riskLevel           String   // "CRITICAL_RISK" | "HIGH_RISK" | "BALANCED" | "OPTIMAL"
  totalNetLiq         Float    // Net Liquidation snapshot
  totalBuyingPower    Float    // Buying Power snapshot
  totalDayPnL         Float    // Today's PnL snapshot
  totalUnrealizedPnL  Float    // Open PnL snapshot
  positionsCount      Int      // Total positions audited
  executiveSummary    String   // Multi-paragraph executive summary
  macroAssessment     String?  // Macro & market regime context
  allocationAnalysis  String?  // Concentration and cash allocation
  greeksExposure      String?  // Total portfolio delta, theta rate, gamma risk
  actionablePlaybooks String   // JSON stringified list of prioritized actions
  criticalAlerts      String?  // JSON stringified urgent flags / tested strikes
  rawAuditJson        String   // Full raw structured JSON from the agent
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([createdAt])
}

model TradeRecord {
  id               String    @id @default(uuid())
  broker           String    // "Tastytrade", "Interactive Brokers", "Manual"
  brokerTradeId    String?   // External broker transaction ID / execId
  symbol           String    // Full contract symbol or equity ticker
  underlyingSymbol String?   // Root ticker (e.g. AAPL, FLNC)
  assetType        String    // "OPTION" | "EQUITY"
  optionType       String?   // "CALL" | "PUT"
  strikePrice      Float?
  expiryDate       String?   // YYYYMMDD or YYYY-MM-DD
  action           String    // "BUY_TO_OPEN", "SELL_TO_CLOSE", "SELL_TO_OPEN", "BUY_TO_CLOSE", "BUY", "SELL"
  side             String    // "BUY" | "SELL"
  positionEffect   String    // "LONG" | "SHORT"
  quantity         Float
  price            Float
  totalValue       Float
  valueEffect      String?   // "CREDIT" | "DEBIT"
  commission       Float?    @default(0)
  clearingFees     Float?    @default(0)
  orderId          String?
  description      String?
  executedAt       DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([broker, brokerTradeId])
  @@index([broker])
  @@index([symbol])
  @@index([executedAt])
}

model DipDiagnosticReport {
  id                      String   @id @default(uuid())
  symbol                  String   // e.g. "NVDA", "AAPL"
  companyName             String   // e.g. "NVIDIA Corporation"
  currentPrice            Float
  dayChangePercent        Float
  distanceFrom52WHigh     Float
  classification          String   // "VOLATILITY_DRIVEN", "FUNDAMENTAL_IMPAIRMENT", "MACRO_SECTOR_ROTATION", "OVERREACTION_OPPORTUNITY"
  verdict                 String   // "STRONG_BUY_DIP", "ACCUMULATE_PULLBACK", "HOLD_WAIT_FOR_BASE", "AVOID_FALLING_KNIFE", "TRIM_DEFENSIVE"
  opportunityScore        Int      // 0 - 100
  fundamentalHealthScore  Int      // 0 - 100
  volatilityFactorPercent Int      // 0 - 100
  fundamentalFactorPercent Int     // 0 - 100
  primaryDriverSummary    String
  executiveDiagnosis      String
  targetEntryZone         String?  // e.g. "$110 - $118"
  dcaStrategy             String?
  optionsStrategy         String?
  stopLossOrInvalidation  String?
  timeHorizon             String?
  contentJson             String   // Full raw structured JSON of the report
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([symbol])
  @@index([createdAt])
}

model PortfolioValuationAudit {
  id                      String   @id @default(uuid())
  title                   String   // e.g. "Portfolio Valuation & Intrinsic Health Audit"
  overallValuationStatus  String   // "DEEPLY_UNDERVALUED" | "UNDERVALUED" | "FAIRLY_VALUED" | "OVERVALUED" | "EXTREMELY_OVERVALUED"
  portfolioDiscountPercent Float   // e.g. +14.5% (undervalued discount) or -12.3% (overvalued premium)
  portfolioScore          Int      // 0 - 100 overall valuation score
  totalMarketValue        Float    // Total audited portfolio equity value
  totalFairValue          Float    // Sum of estimated fair values
  undervaluedCount        Int      // Count of holdings trading below fair value
  fairlyValuedCount       Int      // Count of holdings trading near fair value
  overvaluedCount         Int      // Count of holdings trading above fair value
  totalHoldingsCount      Int      // Total holdings analyzed
  executiveSummary        String   // Multi-paragraph AI diagnosis of portfolio valuation
  keyOpportunitiesSummary String?  // Highlights of top undervalued gems
  valuationRisksSummary   String?  // Highlights of overextended / overvalued holdings
  holdingsValuationsJson  String   // JSON array of detailed asset-by-asset valuation records
  rawReportJson           String   // Complete structured audit report
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([createdAt])
}

